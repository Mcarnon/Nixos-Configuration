// Window & layer rules
//
// 上游（StatIndet/quickshell v2026.9.25）自己写进 ~/.config/niri/clavis/ 的
// window-rule / layer-rule 只有两处，而且都已经在 config.kdl 里 include 了，
// 本文件不重复：
//   clavis/effects.kdl       只写 xray（X-Ray 开启时只有一行注释）
//   clavis/layer-rules.kdl   overview 壁纸 place-within-backdrop
//                            + layout background-color "transparent"
// 上游仓库里没有逐应用规则 —— 作者本机那些没公开。能从他 README 截图反推的只有：
//   - Clavis 主控窗是浮动的，尺寸约为输出的 60% × 85%（2560×1440 截图实测
//     1548×1180，居中于顶栏 52px 专属区之下的工作区）；
//   - 子对话框/文件选择器按窗口自己声明的 implicitWidth/Height 浮动；
//   - 所有圆角都等于 Common/Appearance.qml 的 rounding token。
//
// ⚠️ 尺寸为什么不能照抄 px：作者的屏是 2560×1440 @scale 1（本机面板是
// 1920×1080 @scale 1，见 hosts/laptop/niri-hardware.kdl）。同一组绝对像素在他的
// 屏上占 43%×52%，在本机占 57%×69% —— 所以「浮窗尺寸」分两类处理：
//   - Clavis 自己的窗口用比例（0.6 × 0.85），换屏幕后观感一致；
//   - 其它应用沿用 Clavis 源码里的窗口尺寸（920×600 / 620×640 / 1100×750），
//     这是最接近「他那里长什么样」的参考值，觉得偏大就按 0.75 等比缩小。

// ---- 全局：圆角 + 裁剪 ----
// 23 = Appearance.qml 的 rounding.large。niri 的 geometry-corner-radius 同时决定
// 背景模糊的圆角（niri 文档：用 window-rule 开的 blur 跟随 geometry-corner-radius），
// 所以这条不加，圆角和模糊都会变成方角。
window-rule {
    geometry-corner-radius 23
    clip-to-geometry true
}

// ---- Clavis 主控窗：浮动 + 作者截图的 60% × 85% ----
// title 精确等于 clavis-control-center，且没有 parentWindow（见
// Modules/ControlCenter/ControlCenterWindow.qml），niri 不会自动浮动它。
// 嫌在本机 1920×1080 上偏高（60%×85% = 1152×874）就删掉下面两条 default-*，
// 让它用自己的 implicitWidth/Height（1100×750 = 本机 57%×69%）。
window-rule {
    match title="^clavis-control-center$"
    geometry-corner-radius 23
    clip-to-geometry true
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.85; }
}

// ---- Clavis 子对话框 / 文件选择器：客户端尺寸，圆角按源码 token ----
// extraLarge = 28（NetworkConfigWindow 等），文件选择器 veryLarge = 30。
// 它们都带 parentWindow: root.parentModal，尺寸用自己声明的 implicitWidth/Height。
window-rule {
    match title="^clavis-control-center-[a-z-]+$"
    geometry-corner-radius 28
    clip-to-geometry true
    open-floating true
}

window-rule {
    match title="^clavis-file-picker$"
    geometry-corner-radius 30
    clip-to-geometry true
    open-floating true
}

// ---- 快速终端（Mod+Period）：顶部下拉浮窗 ----
// binds.kdl 用 foot-themed --class quickterminal 拉起。
window-rule {
    match app-id="^quickterminal$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.45; }
    default-floating-position x=0 y=16 relative-to="top"
}

// ---- 浮窗几何：尺寸参考 Clavis 源码里的窗口定义 ----
//   文件管理器       → FilePickerWindow 920×600
//   设置/音量类对话框 → NetworkConfigWindow 620×640
//   大窗口(Spotify)  → ControlCenterWindow 1100×750
window-rule {
    match app-id="^spotify$"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 750; }
}

window-rule {
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 640; }
}

window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 640; }
}

window-rule {
    match app-id=r#"^(Thunar|thunar|org\.gnome\.Nautilus|pcmanfm|pcmanfm-qt)$"#
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 600; }
}

// 图片/视频查看器：必须不透明（半透明会把画面搞花），并且浮动到最上层。
window-rule {
    match app-id="^(imv|mpv|celluloid)$"
    open-floating true
    opacity 1.0
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// 通用文件/首选项对话框：按 Clavis 文件选择器 / 设置对话框的尺寸，避免浮窗过小。
window-rule {
    match title="^(Open|Save|Save As|Save File|Open File|Select File|Select Folder|Choose File|Choose Folder).*"
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 600; }
}
window-rule {
    match title="^(Preferences|Settings|Options|About|Properties|Configure|Configuration).*"
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 640; }
}
window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#
    min-width 876
}

// ---- Chinese-app rules (SHORiN battle-tested) ----
// 聊天/QQ/微信的弹窗（按标题匹配）浮动成独立对话框。
window-rule {
    match title="^(群聊的聊天记录|聊天记录|群相册|日历|重命名|另存为)$"
    open-floating true
}
window-rule {
    match title="^(图片查看器|画中画|图片和视频|视频播放器)$"
    open-floating true
    opacity 1.0
}

// ---- Layer rules ----
// 允许 Clavis 的通知动作/窗口激活（上游不写，但没有它点通知常常唤不起窗口）。
debug {
    honor-xdg-activation-with-invalid-serial
}

// 录屏/共享屏幕时不把通知录进去。
layer-rule {
    match namespace="^notification$"
    block-out-from "screencast"
}
