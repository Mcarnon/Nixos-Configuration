// Window & layer rules
//
// Strategy: dynamic blur (see blur.kdl) + per-app `opacity` on this
// layout's transparent background (config.kdl `background-color
// "transparent"`). Only the per-app rules that differ from the global
// xray-blur baseline in blur.kdl live here.

// ---- All windows: rounded corners, no CSD ----
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// ---- Clavis surfaces ----
// Clavis 的面板/概览/壁纸都是 layer-shell 层表面（不是 toplevel），不需要
// open-floating 规则；它自己的圆角/透明度由 QML 负责。只有独立窗口模式
// （设置窗口、地图窗口等）才落到 toplevel，这里给它圆角浮窗观感。
// app-id 是 quickshell 起的（`qs -c clavis`），窗口标题/应用 id 都可能带
// clavis 前缀，所以两个都匹配。
window-rule {
    match app-id=r#"^(quickshell|clavis)"#
    geometry-corner-radius 20
    clip-to-geometry true
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 750; }
}

// ---- Per-app opacity (see-through but legible) ----
window-rule {
    match app-id="^foot$"
    opacity 0.92
}
window-rule {
    match app-id="^zen-beta$"
    opacity 0.95
}
window-rule {
    match app-id="^obsidian$"
    opacity 0.93
}
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    opacity 0.95
}
window-rule {
    match app-id="^code$"
    opacity 0.94
}
window-rule {
    match app-id="^brave-browser$"
    opacity 1.0
    geometry-corner-radius 10
    clip-to-geometry true
}
window-rule {
    match app-id="^spotify$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
    opacity 0.92
}

// ---- Floating windows (overrides) ----
window-rule {
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}
window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
}
window-rule {
    match app-id=r#"^(Thunar|thunar|org\.gnome\.Nautilus)$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}
window-rule {
    match app-id="^(imv|mpv)$"
    open-floating true
}
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}
window-rule {
    match title="^(Open|Save) File.*$"
    open-floating true
}
window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#
    min-width 876
}

// ---- Chinese-app rules (SHORiN battle-tested) ----
// Chat / QQ / WeChat popups (title-based) open as floating dialogs.
window-rule {
    match title="^(群聊的聊天记录|聊天记录|群相册|日历|重命名|另存为)$"
    open-floating true
}
// Image / video viewers must stay opaque (transparent would garble the
// picture) and float so they appear on top of the workspace.
window-rule {
    match title="^(图片查看器|画中画|图片和视频|视频播放器)$"
    open-floating true
    opacity 1.0
}
window-rule {
    match app-id="^(mpv|celluloid)$"
    opacity 1.0
}

// ---- Layer rules ----
// 允许 Clavis 的通知按钮触发动作、以及 XDG activation 拉起窗口
debug {
    honor-xdg-activation-with-invalid-serial
}

// Clavis 桌面壁纸（Modules/Wallpaper/DesktopWallpaper.qml）画在
// WlrLayer.Background + namespace "clavis-wallpaper" 上。这条规则告诉 niri
// 把它放进 backdrop 层：这样窗口移动/overview 时合成器能直接重绘背景，而
// 不是把整块背景缓存住（否则拖窗口会露出旧帧）。opacity 1.0 是因为
// place-within-backdrop 会让 niri 忽略 layer surface 自带的 alpha。
layer-rule {
    match namespace="^clavis-wallpaper$"
    place-within-backdrop true
    opacity 1.0
}

// Block notifications from screen sharing (privacy)
layer-rule {
    match namespace="^notification$"
    block-out-from "screencast"
}
