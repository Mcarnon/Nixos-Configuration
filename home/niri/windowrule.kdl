// Window & layer rules
//
// ============================ 口径：作者演示图的逐像素实测 ============================
// 作者的屏是 2560×1440 @scale 1（图6 的 fastfetch 写着 "Display: 2560x1440 @180Hz"），
// 演示视频是整屏 1920×1080 录制 = 0.75 倍缩放。于是：
//   帧内像素 ÷ 0.75 = 作者的逻辑像素
//   帧内像素          = 本机 1920×1080 @scale 1 上的同比例像素（可以直接用）
// 在帧内量到（脚本扫竖直/水平边缘，误差 ±8px）：
//
//   窗口间距        75px   两列之间 75、窗口到屏幕边缘 74~76
//                          → 作者 100 逻辑像素；本机取 75（config.kdl 的 layout gaps）
//   竖直留白        75px   窗口帧内 y 113~1004；作者 1440 − 52(顶栏) − 2×100 = 1188
//                          → 帧内 891 ✓（本机顶栏同为 52px，所以上下留白同样是 75）
//   大窗口（图1）   1762px  窗口矩形实测 x 75..1838 = 屏宽的 91.8%，左右留白
//                          75 / 82px 就是 gaps → 占满的是**工作区**（1920），
//                          两侧间距照扣，所以窗口不贴边 → proportion 1.0
//   小窗口（图3/5） 1143px 图3 的设置浮窗、图5 的两列终端一样宽 → 屏宽的 0.6
//
// ⚠️ niri 的 proportion 不是「屏宽百分比」，而是**扣掉 gaps 之后**的比例：
//       实际宽度 = p × (工作区宽 − gaps) − gaps
//    （niri wiki → Layout：proportion 0.25 的四个窗口「不管 gaps 多少都刚好铺满」，
//      只有这个公式成立；gaps 0 时它才退化成 p × 工作区宽。）
//    本机 1920 宽 / gaps 75 下，要让小窗口等于「屏宽的 0.6 = 1152px」，
//    解得 p ≈ 0.665 → 写 2/3（得 1155px，与截图差 3px）。
//    直接照抄 0.6 只有 0.6×1845 − 75 = 1032px，比作者截图窄 110px（屏宽的 6%）——
//    这正是「窗口样式改了好几遍都还原不了」的原因：比例对了但没扣 gaps。
//
//    浮窗走的是另一条路：图3 的设置浮窗实测 1143px = 屏宽的 0.6，而它左右并不需要
//    让出 gaps，所以浮窗直接写 proportion 0.6（= 本机 1152px）就对了。
//    于是「设置/文件管理器浮窗 0.6」「平铺小窗口 2/3」两个不同的数字，
//    落到屏幕上是同一个宽度（1143 / 1155px）—— 不是笔误。
//
// ================================ 本文件的分工 ================================
//   全局兜底  小窗口：没被下面点名的窗口一律按 2/3 开（foot、yazi、Discord…）
//   大窗口    浏览器 / 编辑器 / 笔记 / 录屏 / 3D → 占满工作区宽度（盖掉上面的兜底）
//   浮动      只有「设置」和「文件管理器」，加上它们的对话框、文件选择器、
//             图片/视频查看器、PiP、聊天记录弹窗这类临时窗口；其余全部平铺
//
// 上游（StatIndet/quickshell v2026.9.25）自己写进 ~/.config/niri/clavis/ 的
// window-rule / layer-rule 只有两处，两处都在 config.kdl 里 include 了：
//   clavis/effects.kdl       只写 xray（X-Ray 开启时只有一行注释）
//   clavis/layer-rules.kdl   overview 壁纸 place-within-backdrop
//                            + layout background-color "transparent"
// 其中 backdrop 那条本文件**另外**写了一份（见下面 Layer rules 段落）：上游那个
// 片段只在用户点设置中心的 Set up 时才存在，而「概览里工作区背后要有壁纸」是开箱
// 就该有的行为，不能挂在一次 GUI 操作上。重复对 niri 是幂等的。
//
// ⚠️ 如果 Clavis 的设置中心（通用 → Displays）往 ~/.config/niri/clavis/outputs.kdl
// 写过 per-output 的 layout {}，那份 layout 会**压过** config.kdl 里的全局 layout
// （niri 文档：per-output / 命名工作区的 layout 覆盖全局），症状就是「窗口间距变小、
// 窗口变成全宽」。窗口规则按窗口生效、且后写的规则覆盖先写的，不受它影响 ——
// 所以本文件里的大/小窗口宽度是稳的；但 gaps 只能靠清掉那个 layout 块，
// 或者在 Clavis 设置里把间距也调成 75 来对齐。
// 排查：cat ~/.config/niri/clavis/outputs.kdl，把里面的 layout {} 删掉再重进会话。

// ---- 全局：圆角 + 兜底宽度（小窗口）+ 挡住「自动最大化到边」----
// 23 = Appearance.qml 的 rounding.large。niri 的 geometry-corner-radius 同时决定
// 背景模糊的圆角（niri 文档：用 window-rule 开的 blur 跟随 geometry-corner-radius），
// 所以这条不加，圆角和模糊都会变成方角。
// 宽度是「小窗口」兜底：niri 按出现顺序处理 window-rule，后面的规则覆盖前面的，
// 所以下面的大窗口、浮窗规则都能盖掉它。
//
// ⚠️ open-maximized-to-edges false 是治「浏览器/zed 一开就占满屏」的关键一条：
// niri 有三种「变大」的状态，只有这一种不看 gaps：
//   - maximize-column（Mod+F）= **等价于 proportion 1.0**，仍然留 gaps 和 border
//     （niri 文档 Fullscreen-and-Maximize 原话）—— 所以正常的 proportion 1.0 大窗口
//     应该是 1920 − 2×75 = 1770px，四周留白 75，不会贴边；
//   - maximize-window-to-edges（Mod+M / 双击标题栏 / 点窗口自带方形按钮）：
//     「no struts, gaps, or borders」→ 真正的贴边满屏；
//   - fullscreen（Mod+Shift+F / F11）：连顶栏一起盖住。
// ⚠️ 这条 open-maximized-to-edges false 拦的是「别的应用开窗时自己请求贴边满屏」，
// 让 niri 默认只按下面写的宽度开窗。需要满屏的那几个（浏览器 / zed / blender）
// 在「大窗口 A」里被显式改回 true —— 规则按出现顺序处理，后写的覆盖先写的。
// （注意：本规则 + 大窗口 A 都只管「打开瞬间」。客户端**开出来之后再补**的请求
//   niri 会照办，规则拦不住，所以 A 用的是 niri 主动给的满屏，而不是等客户端请求。）
window-rule {
    geometry-corner-radius 23
    clip-to-geometry true
    default-column-width { proportion 0.6667; }
    open-maximized-to-edges false
}

// ---- 大窗口 A：常用软件直接满屏（用户决定：浏览器 / zed / blender）----
// 这几个天天用，索性固定满屏，不再依赖「客户端自己请求」——那条路会先按 1770 开出来
// 再跳一下（niri 文档：客户端在 initial configure 之后补的请求，规则拦不住），
// 而 open-maximized-to-edges true 是**开窗时**由 niri 直接给的，一次到位、没有跳动。
// 满屏 = maximize-to-edges：贴到工作区边缘，不看 gaps 也不画 border（顶栏仍在）。
// 想让它退回「大但留 75px 间距（1770px）」，把这条里的 open-maximized-to-edges 删掉，
// 或者把这个应用挪到下面「大窗口 B」那条正则里。
window-rule {
    match app-id=r#"^([Zz]en|[Zz]en-beta|[Ff]irefox|[Ff]irefox-developer-edition|[Ff]irefox-nightly|org\.mozilla\.[Ff]irefox|[Cc]hromium|[Cc]hromium-browser|org\.chromium\.[Cc]hromium|[Gg]oogle-chrome|[Gg]oogle-chrome-stable|[Bb]rave-browser|[Mm]icrosoft-edge|[Vv]ivaldi-stable|qutebrowser|[Zz]ed|dev\.[Zz]ed\.[Zz]ed|[Bb]lender)$"#
    open-maximized-to-edges true
    // Mod+M 取消满屏后回到「工作区整宽」而不是 2/3 小窗。
    default-column-width { proportion 1.0; }
}

// ---- 大窗口 B：Obsidian（匹配放到最宽，别再靠枚举）----
// 线索：Obsidian 窗口按 Mod+F（maximize-column）能变宽 —— 那正是这条规则要给的宽度
// （proportion 1.0 = 1770px），说明**规则没匹配到窗口**，不是尺寸写错。
//
// 本机实测（`niri msg pick-window` 点出来的原话）：
//     App ID: "md.Obsidian"
//     Title:  "烧烤 - Mcarnon的三部曲 - Obsidian 1.13.7"
// 「md. 小写 + Obsidian 大写」这个混合写法，把之前锚定枚举的 obsidian /
// Obsidian / md.obsidian.Obsidian / obsidian[0-9.-]* 全躲过去了 —— 这就是它一直
// 是小窗的根因（当时窗口尺寸 1155×878，正好是全局兜底 2/3）。
//
// 所以这里改成「搜」而不是「枚举」：
//   1. 不枚举、也不加 ^…$ —— niri 的正则是在 app-id 里**搜**，只要有 obsidian 这一段
//      就命中（obsidian / Obsidian / md.obsidian / md.Obsidian / md.obsidian.Obsidian /
//      obsidian-1.9.14 / net.obsidian.Obsidian …）；
//   2. 大小写用 [Xx] 字符类覆盖，不用 (?i) 内联开关（少一个「版本差异导致解析失败」的风险）。
window-rule {
    match app-id=r#"[Oo][Bb][Ss][Ii][Dd][Ii][Aa][Nn]"#
    default-column-width { proportion 1.0; }
}

// 标题兜底：万一它的 app-id 完全不叫 obsidian（Electron / XWayland 下有可能报成进程名）。
// 显式 exclude 掉终端 —— 否则 nvim 打开 vault 里的文件时，标题里带路径的终端也会被放大。
window-rule {
    match title=r#"[Oo][Bb][Ss][Ii][Dd][Ii][Aa][Nn]"#
    exclude app-id=r#"^([Ff]oot|footclient|[Aa]lacritty|[Kk]itty|org\.wezfurlong\.wezterm|com\.mitchellh\.ghostty)$"#
    default-column-width { proportion 1.0; }
}

// ---- 大窗口 B 其余：obs-studio / code / jetbrains ----
// 实测窗口矩形 x 75..1838（宽 1762px = 屏宽 91.8%），左右 75 / 82px 的留白就是 gaps。
// 也就是说 niri 的 proportion 1.0 指「工作区宽 1920」，两侧的 gaps 照样扣掉 →
// 1920 − 2×75 = 1770px，窗口永远碰不到屏幕边缘，和截图一致。
// ⚠️ 图1 里那条粉色侧栏（x 74..219）是 **Zen 自己的侧栏**（URL 胶囊 daybook.page、
// 前进/后退/刷新、固定标签页、Zen 的 Space、+ 新建标签页），属于窗口内容 ——
// 所以「网页区域」看着只有 84% 宽，窗口本身是 92%。
// 想让大窗口比工作区更窄（比如留给下一列一个缝隙），把下面的 proportion 改成
// p = (目标宽度 + gaps) / (工作区宽 − gaps)，例如让窗口 ≈1620px 就写 0.92。
// 以后想加应用，把它追加进这个正则即可；app-id 用 `niri msg windows`（看 App ID 行）
// 或 `niri msg pick-window` 点一下窗口查（点一下就会打印 App ID + Title，最省事）。
// ⚠️ 大小写要自己覆盖：niri 的 app-id 正则**区分大小写**，所以每项写成 [Xx] 形式。
window-rule {
    match app-id=r#"^([Oo]bsidian[0-9.-]*|md\.[Oo]bsidian\.[Oo]bsidian|com\.obsproject\.Studio|[Cc]ode|[Cc]ode-oss|[Cc]odium|jetbrains-[a-z-]+)$"#
    default-column-width { proportion 1.0; }
}

// ---- 设置：Clavis 主控窗（浮动，0.6 × 0.85 = 图3 的 1143×890 @1920×1080）----
// title 精确等于 clavis-control-center，且没有 parentWindow（见
// Modules/ControlCenter/ControlCenterWindow.qml），niri 不会自动浮动它。
// opacity 1.0：这条窗口自己就画了 0.8 的背景 + 通过 ext-background-effect 请求模糊
// （config.json 的 effects.shellBackgroundOpacity/shellBlurEnabled），blur.kdl 那条
// 全局 0.9 会再乘上去变成 0.72 —— 面板会比设计稿更透。这里把它还原成 1.0，
// 让「透明 + 模糊」只由 Clavis 自己那一层决定。
window-rule {
    match title="^clavis-control-center$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.85; }
    geometry-corner-radius 23
    clip-to-geometry true
    opacity 1.0
}

// ---- 文件管理器：浮动，尺寸与上面的设置窗一致 ----
// Mod+E 拉起的是 thunar（见 binds.kdl: `spawn-sh "thunar || nautilus"`），
// nautilus / pcmanfm / nemo / dolphin 一并收进来。
// 想让文件管理器也参与平铺，删掉 open-floating 这一行即可 —— 它会退回全局的 2/3 小窗。
window-rule {
    match app-id=r#"^(Thunar|thunar|org\.gnome\.Nautilus|nautilus|pcmanfm|pcmanfm-qt|nemo|dolphin)$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.85; }
}

// ---- Clavis 之外的「设置」类小工具：同样浮动，尺寸沿用源码 token ----
// nm-connection-editor 是 NetworkManager 的设置窗，nwg-look 是本仓库装的 GTK 设置 GUI。
// 音量混音器（pavucontrol）不在此列 —— 按「只有设置和文件管理器浮动」的口径它走平铺，
// 想要它也浮动就把它加进这条正则。
window-rule {
    match app-id=r#"^(nm-connection-editor|gnome-control-center|nwg-look|systemsettings)$"#
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 640; }
}

// ---- Clavis 子对话框 / 文件选择器：客户端尺寸，圆角按源码 token ----
// extraLarge = 28（NetworkConfigWindow 等），文件选择器 veryLarge = 30。
// 它们都带 parentWindow: root.parentModal，宽度继承上面的全局兜底（2/3 = 1280px），
// 高度仍由窗口自己声明。想让它们完全按客户端 implicitWidth/Height 开，
// 在这两条规则里补一行 `default-column-width {}` 即可（niri 文档：这种写法
// 就是给特定窗口用的，niri 会发 (0, H) 的初始 configure，由客户端定宽）。
// opacity 1.0 的理由同上面的主控窗（Clavis 自己画 0.8 + 模糊，别再叠全局 0.9）。
window-rule {
    match title="^clavis-control-center-[a-z-]+$"
    geometry-corner-radius 28
    clip-to-geometry true
    open-floating true
    opacity 1.0
}

window-rule {
    match title="^clavis-file-picker$"
    geometry-corner-radius 30
    clip-to-geometry true
    open-floating true
    opacity 1.0
}

// ---- 快速终端（Mod+Period）：顶部下拉浮窗 ----
// binds.kdl 用 foot-themed --class quickterminal 拉起。
window-rule {
    match app-id="^quickterminal$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.45; }
    default-floating-position x=0 y=16 relative-to="top"
}

// ---- 图片/视频查看器：浮动 + 必须不透明、必须无模糊 ----
// blur.kdl 的全局规则会给所有窗口 0.9 透明 + 背景模糊；对放画面/放视频的窗口来说
// 那是灾难（画面透出壁纸、糊成一团）。opacity 是「换成别的值」，blur false 是
// niri 文档里唯一的「强制关掉」写法（window-rule → background-effect：`blur`
// set to true to enable blur behind this window, or false to force-disable it）。
window-rule {
    match app-id=r#"^(imv|mpv|celluloid)$"#
    open-floating true
    opacity 1.0
    background-effect {
        blur false
    }
}

// 画中画同理（内容也是视频）。想让它也跟着全局玻璃效果，把这两行删掉即可。
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
    opacity 1.0
    background-effect {
        blur false
    }
}

// ---- Blender：必须不透明、必须无模糊（上色/渲染时颜色不能被玻璃效果污染）----
// 两个后果都来自 blur.kdl 那条全局规则：0.9 的窗口透明度会把视口/渲染结果和壁纸
// 做 alpha 混合（看到的颜色不是真实颜色），背景模糊还会在渲染时持续吃掉核显。
// 所以这里强制 opacity 1.0 + blur false（后者是 niri 文档里唯一的「强制关掉」写法）。
// 写法用「搜」而不是「枚举」：本仓库装的是 nixpkgs 的原生 Blender，app-id 通常是
// 小写 blender，但历史上报过 Blender / blender-4.x / Flatpak 的 org.blender.Blender，
// 正则里只写 [Bb]lender 就能全覆盖（和上面 Obsidian 那条同一个教训，见文件头）。
// 想再排除别的「颜色敏感」应用（Krita / GIMP / Inkscape / darktable / Resolve…），
// 把它们按 | 追加进这条正则即可；反过来想让某个应用也参与全局玻璃效果，
// 就把它从这条正则里拿掉。
window-rule {
    match app-id=r#"[Bb]lender"#
    opacity 1.0
    background-effect {
        blur false
    }
}

// ---- 通用文件/首选项对话框：给个固定尺寸，避免浮窗过小或撑满 ----
window-rule {
    match title="^(Open|Save|Save As|Save File|Open File|Select File|Select Folder|Choose File|Choose Folder).*"
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 600; }
}
window-rule {
    match title="^(Preferences|Settings|Options|About|Properties|Configure|Configuration).*"
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 640; }
}

// ---- Chinese-app rules (SHORiN battle-tested) ----
// 聊天/QQ/微信的弹窗（按标题匹配）浮动成独立对话框。
window-rule {
    match title="^(群聊的聊天记录|聊天记录|群相册|日历|重命名|另存为)$"
    open-floating true
}
window-rule {
    match title="^(图片查看器|画中画|图片和视频|视频播放器)$"
    open-floating true
    opacity 1.0
}

// ---- Layer rules ----

// 概览（Overview）与切换工作区时露出的那一层背景 = niri 的 backdrop。
//
// niri 的 backdrop 是「工作区背后 / 工作区之间」可见的那一层；壁纸想出现在那里，
// 该表面必须是 background 层、忽略独占区，并且被 place-within-backdrop
// （niri 文档 Configuration:-Layer-Rules → place-within-backdrop；只有这类表面
// 才会随着 backdrop 一起缩放，并且不再吃输入）。Clavis 的 OverviewWallpaper 就是
// 为这件事存在的表面：namespace `clavis-overview-wallpaper`
// （Modules/Wallpaper/OverviewWallpaper.qml，visible 由设置里的
// 壁纸 → "Enable background" 即 config.json 的 wallpaper.overview.enabled 控制）。
//
// 上游把这条规则写在自己托管的 ~/.config/niri/clavis/layer-rules.kdl 里，但那个
// 文件只有点「设置中心 → 壁纸 → Overview integration → Set up」才会生成，而
// niri_config.py 的 safe_target() 会先拒绝任何「主配置是软链」的机器
// （Symbolic links are read-only: .../niri/config.kdl）——本仓库以前正是把
// config.kdl 做成 /nix/store 软链，所以那条路点了必失败：backdrop 一直是空的，
// 概览里只剩 niri 的 backdrop-color 纯色/黑。
// （现在 config.kdl 由 modules/home/desktop/niri.nix 刷成可写副本，Set up 能用了；
//   这条规则仍然在这里写死，开箱即有效，不依赖任何 GUI 操作。）
//
// 同时它让 Clavis 的 status() 报 overviewSatisfied=true（它扫的是整条 include 链，
// 不要求规则出自它自己那个片段），设置页于是显示
// "Overview is already configured outside Clavis" 而不是一个点不动的 Set up。
// 与 clavis/layer-rules.kdl 里那份重复是无害的（niri 对同一表面重复设同一个值幂等）。
layer-rule {
    match namespace="^clavis-overview-wallpaper$"
    place-within-backdrop true
}

// 允许 Clavis 的通知动作/窗口激活（上游不写，但没有它点通知常常唤不起窗口）。
debug {
    honor-xdg-activation-with-invalid-serial
}

// 录屏/共享屏幕时不把通知录进去。
layer-rule {
    match namespace="^notification$"
    block-out-from "screencast"
}
