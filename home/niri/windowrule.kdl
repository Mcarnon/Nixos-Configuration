// Window & layer rules
//
// Strategy: dynamic blur (see blur.kdl) + per-app `opacity` on this
// layout's transparent background (config.kdl `background-color
// "transparent"`). Only the per-app rules that differ from the global
// xray-blur baseline in blur.kdl live here.

// ---- All windows: rounded corners, no CSD ----
// 23 必须等于 Clavis Appearance.qml 的 rounding.large。Clavis 的窗口用
// anchors.fill: parent 的矩形自绘圆角+1px 描边（ControlCenterWindow.qml
// 的 outerBackground），niri 的 geometry-corner-radius 必须在该圆角之外或
// 恰好相等：小于它会裁掉描边最外侧（描边在圆角处断开），大于它则圆角处
// 露出未裁剪的方角背景。
window-rule {
    geometry-corner-radius 23
    clip-to-geometry true
}

// ---- Clavis panels: floating, rounded, fixed size ----
// Clavis 的控制中心/文件选择器是自绘浮层（title 见 clavis/effects.kdl 的
// window-rule），但 niri 不会自动浮动普通 toplevel，这里显式给尺寸和圆角，
// 保持"圆角浮窗设置面板"的观感。
// 圆角 23 = 上面全局值，重复写是为了本规则块自解释；改全局值时这里要同步。
window-rule {
    match title="^(clavis-control-center|clavis-file-picker)$"
    geometry-corner-radius 23
    clip-to-geometry true
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 750; }
}

// ---- Per-app opacity (see-through but legible) ----
window-rule {
    match app-id="^foot$"
    opacity 0.92
}
window-rule {
    match app-id="^zen-beta$"
    opacity 0.95
}
window-rule {
    match app-id="^obsidian$"
    opacity 0.93
}
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    opacity 0.95
}
window-rule {
    match app-id="^code$"
    opacity 0.94
}
window-rule {
    match app-id="^brave-browser$"
    opacity 1.0
    // 圆角/裁剪继承上面的全局规则，不再单独覆盖。
}
window-rule {
    match app-id="^spotify$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
    opacity 0.92
}

// ---- Floating windows (overrides) ----
window-rule {
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}
window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
}
window-rule {
    match app-id=r#"^(Thunar|thunar|org\.gnome\.Nautilus)$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}
window-rule {
    match app-id="^(imv|mpv)$"
    open-floating true
}
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}
window-rule {
    match title="^(Open|Save) File.*$"
    open-floating true
}
window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#
    min-width 876
}

// ---- Chinese-app rules (SHORiN battle-tested) ----
// Chat / QQ / WeChat popups (title-based) open as floating dialogs.
window-rule {
    match title="^(群聊的聊天记录|聊天记录|群相册|日历|重命名|另存为)$"
    open-floating true
}
// Image / video viewers must stay opaque (transparent would garble the
// picture) and float so they appear on top of the workspace.
window-rule {
    match title="^(图片查看器|画中画|图片和视频|视频播放器)$"
    open-floating true
    opacity 1.0
}
window-rule {
    match app-id="^(mpv|celluloid)$"
    opacity 1.0
}

// ---- Layer rules ----
// Allow Clavis notification actions and window activation
debug {
    honor-xdg-activation-with-invalid-serial
}

// Clavis overview 壁纸必须画在 niri 的 backdrop 层，否则 overview 缩略图会被
// 壁纸盖住（Clavis 自己生成的 clavis/effects.kdl 只管 xray/blur，不管这个）。
// 只匹配 overview 专用命名空间，不要匹配 clavis-wallpaper（桌面壁纸不在
// backdrop，否则会压住普通窗口）。
layer-rule {
    match namespace="^clavis-overview-wallpaper$"
    place-within-backdrop true
}

// Block notifications from screen sharing (privacy)
layer-rule {
    match namespace="^notification$"
    block-out-from "screencast"
}
