// niri main config - laptop + Noctalia desktop shell
// Sub-configs are split via include into *.kdl files in the same directory

input {
    keyboard {
        xkb {
            layout "us"
            // options "ctrl:nocaps"
        }
        repeat-delay 300
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
    }
}

include "niri-hardware.kdl"
include "startup.kdl"
include "windowrule.kdl"
include "binds.kdl"

layout {
    gaps 8
    // Let Noctalia's wallpaper show through behind windows (blur picks it up).
    background-color "transparent"
    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

// Let apps draw their own client-side decorations where appropriate.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
