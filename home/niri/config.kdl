// niri 主配置 - 华为笔记本 + Noctalia 桌面外壳
// 子配置用 include 拆分到同目录下的 *.kdl

input {
    keyboard {
        xkb {
            layout "us"
            // options "ctrl:nocaps"
        }
        repeat-delay 300
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
    }
}

include "output.kdl"
include "startup.kdl"
include "windowrule.kdl"
include "binds.kdl"

layout {
    gaps 8
    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
