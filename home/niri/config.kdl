// niri main config - laptop + Noctalia desktop shell
// Sub-configs are split via include into *.kdl files in the same directory.

// Ask apps to omit client-side decorations; niri draws border/focus ring.
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "adaptive"
        accel-speed 0.2
        scroll-factor 0.8
    }

    // Mouse-over focus (limit scroll to avoid jumping the view).
    focus-follows-mouse max-scroll-amount="10%"
}

cursor {
    xcursor-theme "volantes_cursors"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 3000
}

// Applies to niri-spawned processes only (system-wide vars live in the host).
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XCURSOR_THEME "volantes_cursors"
    XCURSOR_SIZE "24"
    QT_QPA_PLATFORM "wayland"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

include "niri-hardware.kdl"
include "startup.kdl"
include "windowrule.kdl"
include "binds.kdl"
include "blur.kdl"

layout {
    gaps 8

    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    // Gradient focus ring.
    focus-ring {
        width 2
        active-gradient from="#7fc8ff" to="#223366" angle=210 relative-to="workspace-view"
        inactive-color "#505050"
    }

    // Soft window shadow.
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=8
        color "#00000060"
    }
}

animations {
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-cubic"
    }
    // Keep these three in sync for coherent motion (niri docs recommendation).
    window-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
