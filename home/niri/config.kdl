// niri main config - laptop + Clavis (Quickshell) desktop shell
// Sub-configs are split via include into *.kdl files in the same directory.

// Hide window title bars (no CSD).
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "adaptive"
        accel-speed 0.2
        scroll-factor 0.8
    }

    // Mouse-over focus (limit scroll to avoid jumping the view).
    focus-follows-mouse max-scroll-amount="10%"
}

// 光标：主题 + 尺寸。
//
// 这里只是**兜底/声明式默认值**，两个原因：
//   1. niri 的 `cursor {}` 会顺带把它设成 XCURSOR_THEME / XCURSOR_SIZE 环境变量
//      （niri 文档 Configuration:-Miscellaneous → cursor：Change the theme and
//      size of the cursor as well as set the XCURSOR_THEME and XCURSOR_SIZE
//      environment variables），XWayland/X11 应用就是靠这个变量找主题的，所以
//      下面 environment{} 里**不再**重复写 XCURSOR_*（写了就会盖住 niri 从
//      cursor{} 派生的值，Clavis 改光标时 X11 应用会留在旧主题上）。
//   2. Clavis 的设置中心（主题 → 光标主题/尺寸）owns 这个值：它把
//      theme.cursorTheme/cursorSize 写进 ~/.config/niri/clavis/cursor.kdl，
//      而那一行 include 在本文件里位于这个 cursor{} **之后**，所以 Clavis 的值
//      覆盖这里的默认值。cursorTheme 为空（= 它界面上的 "System default"）时
//      它会写 `gsettings get ... cursor-theme` 读到的系统默认主题 —— 也就是
//      appearance.nix 里写成 dconf cursor-theme 的那个名字（与 home.pointerCursor
//      同一个主题），于是 niri / GTK / Qt / X11 才是「一个光标」。
// 因此：换光标主题请改 modules/home/desktop/appearance.nix + 这里两处，
// 或直接在 Clavis 设置里选（那样由 clavis/cursor.kdl 生效）。
//
// ⚠️ 关于 hide-when-typing / hide-after-inactive-ms：niri 对 include 里的 cursor{}
// 是**逐字段合并**（niri-config/src/misc.rs 的 CursorPart + MergeWith：片段没写的
// 字段保留前面块的值，见 niri 文档 Configuration:-Include → Merging），所以下面
// 这两行等于把「打字时隐藏 / 3 秒后隐藏」钉死 —— Clavis 设置中心里那两个开关能改
// 成别的值，但没法把它们关掉（`hide-after-inactive-ms` 在 niri 侧也没有「取消」
// 的写法）。想让 Clavis 全权管就删掉这两行。
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 3000
}

// Applies to niri-spawned processes only (system-wide vars live in the host).
// 刻意不写 XCURSOR_THEME / XCURSOR_SIZE：niri 从上面的 cursor{} 派生这两个变量
// 发给它 spawn 的进程（见 cursor{} 的注释），写死在这里会和 Clavis 运行期改的
// 光标主题打架。
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    // Locale (locale) + input method + QT theme for niri-spawned processes.
    // System-wide equivalents live in hosts/laptop/default.nix + locales/.
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    LC_CTYPE "en_US.UTF-8" // 解决漏字问题（可能影响部分 X11 应用中文输入）
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULES "wayland;fcitx"
    // qt 主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // GTK 软件使用的渲染器（Intel 单显卡可留，无害）
    GSK_RENDERER "gl"
    // 默认文本编辑器
    EDITOR "vim"
    // Quickshell / Clavis 的图标主题。必须是「覆盖面广」的那个：Adwaita 只带
    // 一小撮 GNOME 图标，application-exit / view-refresh 这类 freedesktop
    // action 图标在 Adwaita 里根本没有（只在 breeze 系里），Qt 加载不到就只
    // 剩下按钮底色 —— 看起来就是一块纯色方块。Papirus-Dark Inherits=
    // breeze-dark,hicolor，和 appearance.nix 的 dconf icon-theme、
    // home/files/qt6ct/qt6ct.conf 的 icon_theme 保持一致。
    QS_ICON_THEME "Papirus-Dark"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// 把 niri 启动后设置的 WAYLAND_DISPLAY/XDG_SESSION_TYPE 导入到用户 systemd 环境
// （关键：clavis-shell / fcitx5 / polkit 都是 systemd user 服务，niri 不会自动
// 把会话变量透传过去，不补这一行 clavis 启动会找不到 wayland socket 而崩，
// 表现就是"桌面全黑"——clavis 服务另有 clavis-session-env 兜底等待 socket）
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR"

include "niri-hardware.kdl"
include "startup.kdl"
include "blur.kdl" // 全局 blur 参数（只有 blur{} 参数块，没有透明度规则）
include "clavis-static.kdl" // SHORiN 静态 niri 配色（Clavis 已不再生成 colors.kdl，这是唯一来源）
// Clavis 托管片段（scripts/system/niri_config.py 的 FRAGMENTS 元组）：
//   effects, cursor, layer-rules, binds, outputs, minimize-animation
// 全部必须【提前】写好这几行 include：Clavis 只在 grep 到 include 时才认这个片段
// （否则标成 "not-connected"），而它的 "Set up" 会往 config.kdl 追加 include。
//
// ⚠️ 本文件是 ~/.config/niri/config.kdl 的**源**，但运行时那份不是软链：
// modules/home/desktop/niri.nix 每次 switch 把它刷成一份**可写副本**（内容仍然
// 100% 声明式，别的 .kdl 仍是 store 软链）。原因见那个文件：Clavis 的
// niri_config.py 在写任何片段之前都会先 safe_target(主配置)，而它拒绝软链
// （Symbolic links are read-only: .../niri/config.kdl）——做成软链时它的
// Set up / 光标 / 模糊开关**全部**写不进去（读却正常，所以设置页看起来是好的）。
// 副本换来的是「设置中心真的能改东西」；代价是本文件被 Clavis 追加过的 include
// 不会留存（每次 switch 覆盖回去），所以这六个 include 必须写在这里。
//
// 顺序说明：
//   - effects 只影响 niri 的 xray（Clavis 面板的模糊由它自己通过
//     ext-background-effect 请求，不走 window-rule），放在 blur.kdl 之后。
//   - binds 放在本仓库 binds.kdl 之前：niri 遇到重复键位时按 include 顺序解析，
//     我们让 Clavis 的托管片段先落地。两边在 Mod+Space / Mod+Slash /
//     Mod+Shift+Space / Mod+N / Mod+A / Mod+Shift+T 上绑的是同一个动作，所以
//     谁先谁后结果都一样 —— 关键是不要让"先绑 quick terminal、后绑
//     shortcut-map"这种不同动作的重复键留在配置里。
//   - cursor 在本文件 cursor{} 之后，所以 Clavis 选的光标主题覆盖声明式默认值。
include optional=true "clavis/effects.kdl" // 只写 xray，X-Ray 开启时只有一行注释
include optional=true "clavis/cursor.kdl" // 光标覆盖：Clavis 生成，本仓库另种一份种子（见 clavis 模块）
include optional=true "clavis/layer-rules.kdl" // overview 壁纸 backdrop + 透明背景；规则的兜底副本在 windowrule.kdl
include optional=true "clavis/outputs.kdl" // 显示器配置，由 Clavis 生成
// ⚠️ 这个片段里的 output {} 可以带 layout {}（gaps / default-column-width /
// preset-column-widths / always-center-single-column —— 见上游 niri_outputs.py 的
// LAYOUT 元组），而 niri 的 **per-output layout 优先于本文件末尾的全局 layout**。
// 一旦 Clavis 设置中心（通用 → Displays）把那组值写进去，症状就是「窗口变成全宽
// 平铺 + 窗口间距变小」，而本文件里写着的 gaps 75 好像没生效 —— 而这份全局 layout
// 正是「大窗口 1.0 / 小窗口 2/3 / 间距 75」的唯一 gaps 来源，被盖掉就全乱了。
// 窗口宽度还有 windowrule.kdl 兜着（规则按窗口生效，per-output layout 盖不到），
// 但 gaps 没有 Plan B。
// 排查：cat ~/.config/niri/clavis/outputs.kdl，删掉多余的 layout 块（或在 Clavis
// 设置里把间距也设成 75），再重进会话。
include optional=true "clavis/minimize-animation.kdl" // 最小化动画，由 Clavis 生成
include optional=true "clavis/binds.kdl" // Clavis 托管键位，见上方顺序说明
include "windowrule.kdl" // 大/小窗口宽度 + 设置/文件管理器浮窗 + 全局圆角，见该文件头部说明
include "supertab.kdl" // 带缩略图的 Alt/Ctrl+Tab 窗口切换（SHORiN 原版）
include "binds.kdl"

layout {
    // 窗口间距 75 = 作者演示图逐像素实测值（见 windowrule.kdl 头部）。
    // 帧内量到：两列之间 75px，窗口到屏幕边缘 74~76px；作者本机是 2560×1440
    // @scale 1 全屏录制缩到 1920×1080（0.75 倍），换算成作者逻辑像素是 100，
    // 本机 1920×1080 @scale 1 要还原同样的观感就是 75（占屏宽 3.9%）。
    //
    // 这条同时是窗口到屏幕四周的留白（niri 的 gaps 内外都算），
    // 所以窗口上下沿也会各留 75：帧内 y 113~1004 = 顶栏 52 + 75 到 1080 − 75 ✓。
    gaps 75
    background-color "transparent" // see-through to wallpaper (required for blur to show)

    // 单窗口不再占满整屏宽度，而是居中留白（官方截图里 Zen/终端都是这样）。
    always-center-single-column true

    // 小窗口（foot、yazi、Discord、文件管理器平铺时…）默认宽度。
    //
    // ⚠️ 为什么是 2/3 而不是 0.6：niri 的 proportion 是「扣掉 gaps 之后」的比例，
    //    实际宽度 = p × (工作区宽 − gaps) − gaps（niri wiki → Layout：proportion 0.25
    //    的四个窗口不管 gaps 多少都刚好铺满，只有这个公式成立）。
    //    作者截图里的小窗口实测 ≈1143px = 屏宽的 0.6；本机在 gaps 75 下要让
    //    0.6 × 1920 = 1152px 成立，p 必须 ≈ 0.665 → 写 2/3（实际 1155px，差 3px）。
    //    照抄 0.6 只能得到 0.6×1845 − 75 = 1032px，比截图窄 110px，
    //    而且一改 gaps 就会跟着变 —— 这是之前「怎么改都还原不了」的根因。
    //
    // 大窗口（浏览器/zed/obsidian/obs-studio/blender）由 windowrule.kdl 覆盖成 1.0。
    // 预设给到 1/3、1/2、2/3、满宽，Mod+R 循环。
    default-column-width { proportion 0.6667; }

    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6667
        proportion 1.0
    }

    // 1px 描边：Clavis 每个面板都自绘 1px colOutline 边框，niri 侧对齐。
    // 颜色在 clavis-static.kdl。
    border {
        width 1
    }

    // 焦点环只写几何，配色归 clavis-static.kdl（那里是 niri 唯一的强调色来源）。
    //
    // 原来这里还写着 SHORiN 的渐变 #7fc8ff → #223366 和 inactive-color #505050，
    // 但本块在 include 之后解析，而 niri 的合并规则（niri-config/src/macros.rs
    // merge_color_gradient!）是「后写的 gradient 直接生效，且不会清掉已设的
    // color」；渲染时又是 gradient 优先（focus_ring.rs: gradient.unwrap_or(color)）。
    // 结果就是 clavis-static.kdl 里的 #bec2ff / #131316 全是死值，界面一直在用
    // 另一套蓝色调色板 —— 与 Clavis 主色对不上。
    focus-ring {
        width 2
    }

    // 阴影同理：颜色只在 clavis-static.kdl 设一次（#00000070），这里只留几何。
    // offset y=7 对齐 SpotlightStyle.qml 的 shadowVerticalOffset。
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=7
    }

}

// Animation: all-spring (SHORiN pattern) for cohesive feel.
animations {
    slowdown 0.98

    window-open {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.84 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=500 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.82 stiffness=400 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
