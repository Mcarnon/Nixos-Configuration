// niri main config - laptop + Clavis (Quickshell) desktop shell
// Sub-configs are split via include into *.kdl files in the same directory.

// Hide window title bars (no CSD).
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "adaptive"
        accel-speed 0.2
        scroll-factor 0.8
    }

    // Mouse-over focus (limit scroll to avoid jumping the view).
    focus-follows-mouse max-scroll-amount="10%"
}

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 3000
}

// Applies to niri-spawned processes only (system-wide vars live in the host).
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XCURSOR_THEME "breeze_cursors"
    XCURSOR_SIZE "24"
    QT_QPA_PLATFORM "wayland"
    // Locale (locale) + input method + QT theme for niri-spawned processes.
    // System-wide equivalents live in hosts/laptop/default.nix + locales/.
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    LC_CTYPE "en_US.UTF-8" // 解决漏字问题（可能影响部分 X11 应用中文输入）
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULES "wayland;fcitx"
    // qt 主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // GTK 软件使用的渲染器（Intel 单显卡可留，无害）
    GSK_RENDERER "gl"
    // 默认文本编辑器
    EDITOR "vim"
    // Quickshell / Clavis 的图标主题。必须是「覆盖面广」的那个：Adwaita 只带
    // 一小撮 GNOME 图标，application-exit / view-refresh 这类 freedesktop
    // action 图标在 Adwaita 里根本没有（只在 breeze 系里），Qt 加载不到就只
    // 剩下按钮底色 —— 看起来就是一块纯色方块。Papirus-Dark Inherits=
    // breeze-dark,hicolor，和 appearance.nix 的 dconf icon-theme、
    // home/files/qt6ct/qt6ct.conf 的 icon_theme 保持一致。
    QS_ICON_THEME "Papirus-Dark"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// 把 niri 启动后设置的 WAYLAND_DISPLAY/XDG_SESSION_TYPE 导入到用户 systemd 环境
// （关键：clavis-shell / fcitx5 / polkit 都是 systemd user 服务，niri 不会自动
// 把会话变量透传过去，不补这一行 clavis 启动会找不到 wayland socket 而崩，
// 表现就是"桌面全黑"——clavis 服务另有 clavis-session-env 兜底等待 socket）
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR"

include "niri-hardware.kdl"
include "startup.kdl"
include "blur.kdl" // 全局 blur 参数（只有 blur{} 参数块，没有透明度规则）
include "clavis-static.kdl" // SHORiN 静态 niri 配色（Clavis 已不再生成 colors.kdl，这是唯一来源）
// Clavis 托管片段（scripts/system/niri_config.py 的 FRAGMENTS 元组）：
//   effects, cursor, layer-rules, binds, outputs, minimize-animation
// 全部必须【提前】写好这几行 include：Clavis 的 manage-niri-fragment.sh 只在
// 自己 grep 到 include 时才肯写片段，缺一个就把该片段标成 "not-connected"；而
// 它自己的 "Set up" 会往 config.kdl 追加 include —— config.kdl 是指向
// /nix/store 的只读软链，追加会失败（追加成功反而更糟：声明式文件悄悄变成普通
// 文件，下次 home-manager switch 又变回软链，include 丢失，来回抖动）。
//
// 顺序说明：
//   - effects 只影响 niri 的 xray（Clavis 面板的模糊由它自己通过
//     ext-background-effect 请求，不走 window-rule），放在 blur.kdl 之后。
//   - binds 放在本仓库 binds.kdl 之前：niri 遇到重复键位时按 include 顺序解析，
//     我们让 Clavis 的托管片段先落地。两边在 Mod+Space / Mod+Slash /
//     Mod+Shift+Space / Mod+N / Mod+A / Mod+Shift+T 上绑的是同一个动作，所以
//     谁先谁后结果都一样 —— 关键是不要让"先绑 quick terminal、后绑
//     shortcut-map"这种不同动作的重复键留在配置里。
include optional=true "clavis/effects.kdl" // 只写 xray，X-Ray 开启时只有一行注释
include optional=true "clavis/cursor.kdl" // 光标覆盖，由 Clavis 生成
include optional=true "clavis/layer-rules.kdl" // overview 壁纸 backdrop + 透明背景，由 Clavis 生成
include optional=true "clavis/outputs.kdl" // 显示器配置，由 Clavis 生成
// ⚠️ 这个片段里的 output {} 可以带 layout {}（gaps / default-column-width /
// preset-column-widths / always-center-single-column —— 见上游 niri_outputs.py 的
// LAYOUT 元组），而 niri 的 **per-output layout 优先于本文件末尾的全局 layout**。
// 一旦 Clavis 设置中心（通用 → Displays）把那组值写进去，症状就是「窗口变成全宽
// 平铺 + 窗口间距变小」，而本文件里写着的 gaps 16 / proportion 0.6 好像没生效。
// 排查：cat ~/.config/niri/clavis/outputs.kdl，删掉多余的 layout 块，再重进会话。
include optional=true "clavis/minimize-animation.kdl" // 最小化动画，由 Clavis 生成
include optional=true "clavis/binds.kdl" // Clavis 托管键位，见上方顺序说明
include "windowrule.kdl" // 全局圆角 + Clavis 面板浮窗 + 其它应用浮窗尺寸，见该文件头部说明
include "supertab.kdl" // 带缩略图的 Alt/Ctrl+Tab 窗口切换（SHORiN 原版）
include "binds.kdl"

layout {
    // 窗口间距 16 = Clavis Appearance.qml 的 spacing.large / Metrics.spacingL。
    gaps 16
    background-color "transparent" // see-through to wallpaper (required for blur to show)

    // 单窗口不再占满整屏宽度，而是居中留白（官方截图里 Zen/终端都是这样）。
    always-center-single-column true

    // 单/新窗口默认 60% 宽度居中；预设给到 1/3、1/2、2/3、满宽。
    // 这四个参数正是 Clavis 设置页「显示 → 高级」按输出托管的那组
    // （scripts/system/niri_outputs.py 的 LAYOUT），官方截图用的是作者本机的值。
    default-column-width { proportion 0.6; }

    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6667
        proportion 1.0
    }

    // 1px 描边：Clavis 每个面板都自绘 1px colOutline 边框，niri 侧对齐。
    // 颜色在 clavis-static.kdl。
    border {
        width 1
    }

    // 焦点环只写几何，配色归 clavis-static.kdl（那里是 niri 唯一的强调色来源）。
    //
    // 原来这里还写着 SHORiN 的渐变 #7fc8ff → #223366 和 inactive-color #505050，
    // 但本块在 include 之后解析，而 niri 的合并规则（niri-config/src/macros.rs
    // merge_color_gradient!）是「后写的 gradient 直接生效，且不会清掉已设的
    // color」；渲染时又是 gradient 优先（focus_ring.rs: gradient.unwrap_or(color)）。
    // 结果就是 clavis-static.kdl 里的 #bec2ff / #131316 全是死值，界面一直在用
    // 另一套蓝色调色板 —— 与 Clavis 主色对不上。
    focus-ring {
        width 2
    }

    // 阴影同理：颜色只在 clavis-static.kdl 设一次（#00000070），这里只留几何。
    // offset y=7 对齐 SpotlightStyle.qml 的 shadowVerticalOffset。
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=7
    }

}

// Animation: all-spring (SHORiN pattern) for cohesive feel.
animations {
    slowdown 0.98

    window-open {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.84 stiffness=400 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=500 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.82 stiffness=400 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
