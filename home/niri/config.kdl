// ============================================================================
// niri config — SHORiN minimal-niri 移植版（shorin-arch-setup）
// 25.11 起 niri 支持配置拆分：binds=快捷键, rule=窗口/layer 规则,
// niri-hardware.kdl = 本机显示器（由 host 提供，对应原版的 output.kdl）。
// 已按 NixOS 适配：polkit/fcitx5/waybar/mako 由 systemd 用户服务管理，
// 不再在此 spawn；去掉 Arch 专属项（linuxqq-clipsync、swayidle）。
// ============================================================================
include "binds.kdl"
include "rule.kdl"
include "layout.kdl"
include "niri-hardware.kdl"

// 截图保存位置
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d %H-%M-%S.png"

// ---- 环境变量 ----
environment {
    LANGUAGE "zh_CN:en"
    LANG "zh_CN.UTF-8"
    LC_CTYPE "en_US.UTF-8" // 解决漏字问题（可能影响部分 X11 应用中文输入）
    // 输入法环境变量
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULES "wayland;fcitx"
    // qt 主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // GTK 软件使用的渲染器（Intel 单显卡可留，无害）
    GSK_RENDERER "gl"
    // 默认文本编辑器
    EDITOR "vim"
}

// ---- 光标 ----
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 30
    hide-after-inactive-ms 15000
}

// ---- 带缩略图的 alt+tab 切换窗口 ----
recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// ---- 输入设备 ----
input {
    keyboard {
        xkb {
            // 布局在 hosts 里配置（locales 框架），这里保持默认
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed -0.15
        accel-profile "flat"
    }

    trackpoint {
    }
}

// ---- Overview ----
overview {
    workspace-shadow {
    }
    zoom 0.5
}

// ---- 启动项（常驻服务：polkit/fcitx5/waybar/mako 走 systemd 用户服务）----
// 屏幕分享/录屏环境
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri"
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
// foot server（Mod+T 等用 footclient 连接）
spawn-at-startup "foot" "-s"
// 剪贴板守护（Wayland 侧存入 cliphist）
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
// 护眼模式（wlsunset，经纬度在 scripts/toggle-wlsunset 里改）
spawn-at-startup "~/.config/niri/scripts/toggle-wlsunset"
// 默认壁纸（Shorin 原图，由 HM 部署到 ~/Pictures/Wallpapers/）
spawn-sh-at-startup "awww img ~/Pictures/Wallpapers/wallhaven-d88d53.png --transition-type none"
// 截图音效守护（binds 里按 Print 会 SIGUSR1 上膛）
spawn-at-startup "screenshot-sound"
// 允许 root 通过用户的 xwayland 打开窗口
spawn-at-startup "xhost" "+si:localuser:root"
// 音量/亮度 OSD（swayosd-client 的上层服务）
spawn-at-startup "swayosd-server"

// 取消启动时的快捷键教程弹窗
hotkey-overlay {
    skip-at-startup
}

// 隐藏窗口标题栏（无 CSD）
prefer-no-csd
