// Keybindings
binds {
    // ---- Noctalia v5 (noctalia msg) ----
    Mod+Space hotkey-overlay-title="App launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Control center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg panel-toggle control-center"; }
    Alt+Tab hotkey-overlay-title="Switch windows" { spawn-sh "noctalia msg window-switcher"; }
    Mod+F2 hotkey-overlay-title="Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+W hotkey-overlay-title="Wallpaper picker" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Shift+B hotkey-overlay-title="Toggle bar" { spawn-sh "noctalia msg bar-toggle"; }

    // ---- Volume / brightness (via Noctalia IPC so the OSD + bar update) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    // ---- Media (noctalia MPRIS) ----
    Mod+P { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPlay { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev { spawn-sh "noctalia msg media previous"; }
    XF86AudioStop { spawn-sh "noctalia msg media stop"; }

    // ---- Launch / help ----
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+E hotkey-overlay-title="File manager" { spawn-sh "thunar || nautilus"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "zen-beta"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }

    // ---- Window actions ----
    Mod+Q { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O { toggle-overview; }
    Mod+Shift+O { toggle-window-rule-opacity; }

    // ---- Focus / move ----
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }

    // ---- Workspaces ----
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // ---- Screenshots (Print = built-in interactive selection) ----
    Print { screenshot; }
    Ctrl+Print { screenshot-screen write-to-disk=false; }
    Alt+Print { screenshot-window write-to-disk=false; }

    // ---- Lock / quit ----
    Super+Alt+L { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    // Suspend combo: turn off monitors, lock, then suspend (shorin pattern).
    Mod+Alt+P hotkey-overlay-title="Suspend" { spawn-sh "niri msg action power-off-monitors && noctalia msg session lock-and-suspend"; }

    // ---- Power user picks (shorin-derived, non-conflicting) ----
    // Drop-down floating terminal (uses kitty class; falls back to foot if
    // kitty isn't installed).
    Mod+Slash hotkey-overlay-title="Quick terminal" { spawn-sh "kitty --class quickterminal 2>/dev/null || foot --class quickterminal"; }
    // Force-kill a stuck window (sends SIGTERM via niri IPC then escalates).
    Alt+F4 hotkey-overlay-title="Force kill window" { spawn-sh "niri msg action close-window --id $(niri msg --json focused-window | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"id\"])')"; }
    // Random wallpaper (Noctalia native wallpaper rotation).
    Mod+F10 hotkey-overlay-title="Random wallpaper" { spawn-sh "noctalia msg wallpaper-random"; }
    // Random wallpaper from the API + save to Wallpapers (SHORiN script).
    Mod+Shift+F10 hotkey-overlay-title="Random download wallpaper" { spawn-sh "random-anime-wallpaper-noctalia"; }
    // Dynamic wallpaper controls.
    Mod+Ctrl+F10 hotkey-overlay-title="Toggle auto rotation" { spawn-sh "dynamic-wallpaper toggle-auto"; }
    Mod+F11 hotkey-overlay-title="Next wallpaper" { spawn-sh "dynamic-wallpaper next"; }
    // Screenshot -> edit (opens satty with the last screenshot from clipboard).
    Mod+Shift+S hotkey-overlay-title="Edit last screenshot" { spawn-sh "wl-paste | satty -f -"; }
    // Wheel scroll to change workspace (cooldown prevents runaway).
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
}
