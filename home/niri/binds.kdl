// Keybindings
binds {
    // ---- Clavis shell (key ipc call) ----
    // Method signatures are taken from the IpcHandler registrations in the
    // shell itself (AppShell.qml / Modules/Keystone/Keystone.qml), not guessed:
    // `control-center open|toggle` take a pageId, and `general` is the valid id
    // for the main settings page.
    Mod+Space hotkey-overlay-title="App launcher" { spawn-sh "key ipc call spotlight toggle"; }
    Mod+S hotkey-overlay-title="Control center" { spawn-sh "key ipc call control-center toggle general"; }
    Mod+Comma { spawn-sh "key ipc call control-center open general"; }
    Mod+F2 hotkey-overlay-title="Hub (dashboard/media/wallpaper/weather)" { spawn-sh "key ipc call keystone hub"; }
    Mod+Shift+B hotkey-overlay-title="Dashboard" { spawn-sh "key ipc call keystone dashboard"; }
    Mod+Shift+T hotkey-overlay-title="Tool panel" { spawn-sh "key ipc call keystone tools"; }
    Mod+N hotkey-overlay-title="Notification sidebar" { spawn-sh "key ipc call sidebar toggle dashboard"; }
    Mod+A hotkey-overlay-title="Quick settings sidebar" { spawn-sh "key ipc call sidebar toggle quicksettings"; }
    // Clavis has no dedicated window switcher; niri's overview is the switcher
    // and Clavis paints its overview wallpaper into the backdrop layer.
    Alt+Tab hotkey-overlay-title="Switch windows" { toggle-overview; }
    // NyxNiri wallpaper picker (GTK3, talks to `key ipc`; kept instead of
    // `spotlight openMode wallpapers` because it shows thumbnails + tones).
    Mod+W hotkey-overlay-title="Wallpaper picker" { spawn-sh "~/.config/niri/scripts/wallpaper-picker.py"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "key ipc call spotlight openMode clipboard"; }
    Mod+Shift+Space hotkey-overlay-title="Web search" { spawn-sh "key ipc call spotlight web"; }

    // ---- Volume / brightness (pamixer / brightnessctl; Clavis mirrors the level in the bar) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-i" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-d" "5"; }
    XF86AudioMute allow-when-locked=true { spawn "pamixer" "-t"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // ---- Media (MPRIS, needs playerctl; Clavis MediaManager picks it up) ----
    Mod+P { spawn "playerctl" "play-pause"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86AudioStop { spawn "playerctl" "stop"; }

    // ---- Launch / help ----
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+E hotkey-overlay-title="File manager" { spawn-sh "thunar || nautilus"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "zen-beta"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }

    // ---- Window actions ----
    Mod+Q { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O { toggle-overview; }
    Mod+Shift+O { toggle-window-rule-opacity; }

    // ---- Focus / move ----
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }

    // ---- Workspaces ----
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // ---- Screenshots (Print = built-in interactive selection) ----
    Print { screenshot; }
    Ctrl+Print { screenshot-screen write-to-disk=false; }
    Alt+Print { screenshot-window write-to-disk=false; }

    // ---- Lock / quit ----
    Super+Alt+L { spawn-sh "key ipc call lock open"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    // Suspend combo: turn off monitors, lock, then suspend (shorin pattern).
    Mod+Alt+P hotkey-overlay-title="Suspend" { spawn-sh "niri msg action power-off-monitors && key ipc call lock open && systemctl suspend"; }

    // ---- Power user picks (shorin-derived, non-conflicting) ----
    // Drop-down floating terminal. Note: kitty is not installed in this config
    // (gui.nix only ships foot), so the fallback is what actually runs.
    Mod+Period hotkey-overlay-title="Quick terminal" { spawn-sh "foot --class quickterminal"; }
    Mod+Slash hotkey-overlay-title="Shortcut map" { spawn-sh "key ipc call shortcut-map toggle"; }
    // Force-kill a stuck window (sends SIGTERM via niri IPC then escalates).
    Alt+F4 hotkey-overlay-title="Force kill window" { spawn-sh "niri msg action close-window --id $(niri msg --json focused-window | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"id\"])')"; }
    // Random wallpaper (Clavis wallpaper IPC: set + regenerate matugen theme).
    Mod+F10 hotkey-overlay-title="Random wallpaper" { spawn-sh "key ipc call wallpaper random"; }
    // Download a random anime wallpaper and apply it through Clavis.
    Mod+Shift+F10 hotkey-overlay-title="Random download wallpaper" { spawn-sh "random-anime-wallpaper-clavis"; }
    // Screenshot → edit (opens satty with the last screenshot from clipboard).
    Mod+Shift+S hotkey-overlay-title="Edit last screenshot" { spawn-sh "wl-paste | satty -f -"; }
    // Wheel scroll to change workspace (cooldown prevents runaway).
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
}
