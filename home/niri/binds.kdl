// Keybindings
binds {
    // ---- Clavis shell (`key ipc call <target> <method> [args...]`) ----
    // 旧键位 → 新动作：Mod+S/F2/W/V/Shift+F10（iNiR 的 controlPanel /
    // dashboard / wallpaperSelector / clipboard / random+live wallpaper）
    // 没有一一对应项：Clavis 对应功能都收在 Spotlight 的 openMode 模式里，
    // 而且 key-cli 不提供 random/live 壁纸的命令行入口。
    // 刻意不写裸 `quickshell ipc`：`key` 的 wrapper（pkgs/key-cli）已经把
    // PATH / QML_IMPORT_PATH / XDG_CONFIG_DIRS 钉死了，niri 的 spawn 直连
    // PATH（不过 shell），所以 ~/.local/bin/key 是唯一可靠的入口。
    // 全部动作目录：`key ipc show`；Clavis 设置 → 快捷键页里没绑定的动作
    // （shortcut-map、lyrics、drawer/weather 侧栏…）可以在那里自己绑。
    // repeat=false：面板类动作连按会自己 toggle 回来。
    Mod+Space repeat=false hotkey-overlay-title="Spotlight (search / apps / web)" { spawn "key" "ipc" "call" "spotlight" "toggle"; }
    Mod+Shift+Space repeat=false hotkey-overlay-title="Web search" { spawn "key" "ipc" "call" "spotlight" "web"; }
    // 剪贴板/壁纸都从 Spotlight 进（Ctrl+1/2/3/4 在模式间切换）。
    Mod+Alt+V repeat=false hotkey-overlay-title="Clipboard history" { spawn "key" "ipc" "call" "spotlight" "openMode" "clipboard"; }
    Mod+Alt+W repeat=false hotkey-overlay-title="Wallpapers" { spawn "key" "ipc" "call" "spotlight" "openMode" "wallpapers"; }
    Mod+N repeat=false hotkey-overlay-title="Dashboard (notifications / weather / widgets)" { spawn "key" "ipc" "call" "sidebar" "toggle" "dashboard"; }
    Mod+A repeat=false hotkey-overlay-title="Quick settings (volume / brightness)" { spawn "key" "ipc" "call" "sidebar" "toggle" "quicksettings"; }
    Mod+Comma repeat=false hotkey-overlay-title="Settings" { spawn "key" "ipc" "call" "control-center" "toggle" "general"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="Keystone panel" { spawn "key" "ipc" "call" "keystone" "hub"; }
    Mod+Shift+T repeat=false hotkey-overlay-title="Tools (record / screenshot)" { spawn "key" "ipc" "call" "keystone" "tools"; }
    // 命令面板：/calc、/fx、/time、/settings… 全在这里（Spotlight 里打 > 也行）。
    Mod+Shift+B repeat=false hotkey-overlay-title="Command palette" { spawn "key" "ipc" "call" "spotlight" "commands"; }
    // Alt+Tab 走 niri 原生 overview（见 supertab.kdl 的带缩略图切换）：
    // Clavis 也有自己的 altSwitcher/orbit，但窗口切换交给合成器更稳。
    Alt+Tab hotkey-overlay-title="Switch windows" { toggle-overview; }

    // ---- Volume / brightness (pamixer / brightnessctl；Clavis 快捷设置侧栏会镜像当前值) ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-i" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-d" "5"; }
    XF86AudioMute allow-when-locked=true { spawn "pamixer" "-t"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // ---- Media (MPRIS, needs playerctl；Clavis 的媒体模块接管同一个播放器) ----
    Mod+P { spawn "playerctl" "play-pause"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86AudioStop { spawn "playerctl" "stop"; }

    // ---- Launch / help ----
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+E hotkey-overlay-title="File manager" { spawn-sh "thunar || nautilus"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "zen-beta"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }

    // ---- Window actions ----
    Mod+Q { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O { toggle-overview; }
    Mod+Shift+O { toggle-window-rule-opacity; }

    // ---- Focus / move ----
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }

    // ---- Workspaces ----
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // ---- Screenshots (Print = built-in interactive selection) ----
    Print { screenshot; }
    Ctrl+Print { screenshot-screen write-to-disk=false; }
    Alt+Print { screenshot-window write-to-disk=false; }

    // ---- Lock / quit ----
    Super+Alt+L repeat=false { spawn "key" "ipc" "call" "lock" "open"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    // Suspend combo: turn off monitors, lock, then suspend (shorin pattern).
    Mod+Alt+P hotkey-overlay-title="Suspend" { spawn-sh "niri msg action power-off-monitors && key ipc call lock open && systemctl suspend"; }

    // ---- Power user picks (shorin-derived, non-conflicting) ----
    // Drop-down floating terminal (uses kitty class; falls back to foot if
    // kitty isn't installed).
    Mod+Slash hotkey-overlay-title="Quick terminal" { spawn-sh "kitty --class quickterminal 2>/dev/null || foot --class quickterminal"; }
    // Force-kill a stuck window (sends SIGTERM via niri IPC then escalates).
    Alt+F4 hotkey-overlay-title="Force kill window" { spawn-sh "niri msg action close-window --id $(niri msg --json focused-window | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"id\"])')"; }
    // Screenshot → edit (opens satty with the last screenshot from clipboard).
    Mod+Shift+S hotkey-overlay-title="Edit last screenshot" { spawn-sh "wl-paste | satty -f -"; }
    // Wheel scroll to change workspace (cooldown prevents runaway).
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
}
