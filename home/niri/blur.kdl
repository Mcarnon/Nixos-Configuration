// Window blur (niri 26.04+).
//
// Dynamic mode (xray false): every window blurs whatever is behind it each
// frame — wallpaper AND other windows show through the glass. Heavier than
// the old xray-static mode, and the blur briefly disappears during
// open/close animations (niri limitation). Look ported from NyxNiri
// (ech678/NyxNiri, configs/niri/effects_normal.kdl).
//
// This file is included BEFORE windowrule.kdl on purpose: it sets the
// global opacity baseline (all 0.9, unfocused 0.85), and the per-app
// `opacity` rules in windowrule.kdl override it for specific apps.
blur {
    passes 3
    offset 2.3
    noise 0.001
    saturation 2
}

window-rule {
    opacity 0.9
    background-effect {
        blur true
        xray false
    }
}

// Unfocused windows dim slightly for depth under the glass.
window-rule {
    match is-focused=false
    opacity 0.85
}
