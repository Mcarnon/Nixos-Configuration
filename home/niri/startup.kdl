// Startup commands for niri session.
// Clavis (the Quickshell desktop shell) runs as a user systemd service
// (`clavis-shell.service`, see modules/home/desktop/clavis/default.nix),
// and fcitx5 as another (`systemd.user.services.fcitx5` in
// modules/nixos/desktop/niri.nix) — both under graphical-session.target,
// so nothing desktop-shell-related is spawned here.
// systemd --user is started by the wayland-session script (greetd env).

// XWayland-on-demand for legacy X11 apps (QQ, WeChat, older electron apps).
// niri 25.08+ auto-spawns this on demand, but starting it explicitly is safer.
spawn-at-startup "xwayland-satellite"

// Network manager tray applet.
spawn-at-startup "nm-applet" "--indicator"
