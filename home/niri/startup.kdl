// Start the Noctalia desktop shell
spawn-at-startup "noctalia"

// Start fcitx5 input method daemon
// The systemd user service in modules/nixos/desktop/niri.nix also tries to
// start fcitx5 via graphical-session.target, but niri does not auto-activate
// that target — spawning it here is the reliable path. The systemd service
// will detect the running instance and stay dormant.
spawn-at-startup "fcitx5"
