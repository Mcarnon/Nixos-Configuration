// Startup commands for niri session.
// Quickshell (the desktop shell) runs as a user systemd service pulled in
// by graphical-session.target (see modules/home/desktop/quickshell/default.nix
// and modules/nixos/desktop/niri.nix for how niri-session-wrapper activates
// the target). So we don't spawn it here — letting systemd manage it gives
// us crash recovery and a single source of truth.

// XWayland-on-demand for legacy X11 apps (QQ, WeChat, older electron apps).
// niri 25.08+ auto-spawns this on demand, but starting it explicitly is safer.
spawn-at-startup "xwayland-satellite"

// Network manager tray applet.
spawn-at-startup "nm-applet" "--indicator"
