// Startup commands for niri session.
// Noctalia v5 (the desktop shell) runs as a user systemd service
// (`noctalia.service`, via the official home-manager module under
// niri.service), and fcitx5 as another
// (`systemd.user.services.fcitx5` in modules/nixos/desktop/niri.nix).

// 环境传播（关键）：niri 自己设置 WAYLAND_DISPLAY，但 systemd 用户服务
// （noctalia 等）的环境来自 systemd user manager，拿不到。不传播的话
// noctalia 启动找不到 wayland socket 会直接崩溃（桌面只剩灰屏）。必须在
// niri 启动后立刻把 WAYLAND_DISPLAY 写进 systemd 用户环境。
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri"
spawn-sh-at-startup "systemctl --user set-environment WAYLAND_DISPLAY=$WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri"

// XWayland-on-demand for legacy X11 apps (QQ, WeChat, older electron apps).
// niri 25.08+ auto-spawns this on demand, but starting it explicitly is safer.
spawn-at-startup "xwayland-satellite"

// Network manager tray applet.
spawn-at-startup "nm-applet" "--indicator"
