#!/bin/sh
# clavis-session-env — 在启动 Clavis 之前把 Wayland 会话环境补齐。
#
# 为什么需要：clavis-shell.service 是 systemd --user 服务，它继承的是 user
# manager 的环境。niri 是 greetd 拉起的，WAYLAND_DISPLAY 只有 niri 自己知道；
# niri 的 spawn-sh-at-startup 会把它 import 进 user manager，但那要等 niri
# 启动脚本跑到那一行。服务本身被 graphical-session.target 拉起来时可能还拿
# 不到 socket —— 这正是以前"切到 Clavis 直接黑屏"的根因。
#
# 行为：
#   1. 已有可用的 WAYLAND_DISPLAY 就直接用；
#   2. 否则在 XDG_RUNTIME_DIR 里等 socket 出现（最多 ~20s，优先 wayland-1/2，
#      排除 wayland-0 —— 那是常见的 X11/其它会话占用的名字）；
#   3. 顺手 `systemctl --user import-environment`，让 fcitx5 / 截图 / 剪贴板
#      之类的其他 user 服务也拿到同一个 socket；
#   4. exec 真正的命令（key shell / key clipboard watch）。
#
# 用法: clavis-session-env <command> [args...]

set -eu

if [ "$#" -lt 1 ]; then
    echo "usage: clavis-session-env <command> [args...]" >&2
    exit 2
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$runtime_dir"

usable_socket() {
    [ -n "${1:-}" ] && [ -S "$runtime_dir/$1" ]
}

if ! usable_socket "${WAYLAND_DISPLAY:-}"; then
    found=""
    # 20s × 0.5s：niri 通常在 1~2s 内建好 socket，20s 只是保险上限。
    i=0
    while [ "$i" -lt 40 ]; do
        for candidate in wayland-1 wayland-2 wayland-3 wayland-4 wayland-0; do
            if usable_socket "$candidate"; then
                found="$candidate"
                break
            fi
        done
        [ -n "$found" ] && break
        i=$((i + 1))
        sleep 0.5
    done
    if [ -z "$found" ]; then
        echo "clavis-session-env: no wayland socket under $runtime_dir" >&2
        exit 3
    fi
    WAYLAND_DISPLAY="$found"
    export WAYLAND_DISPLAY
    # 尽力而为：让别的 user 服务也能看到（失败无所谓，不能因此退出）。
    systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR >/dev/null 2>&1 || true
fi

# Qt/桌面约定：Clavis 是 Qt 应用，这些和 niri 环境块保持一致。
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QS_ICON_THEME="${QS_ICON_THEME:-Adwaita}"
export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
export QT_IM_MODULES="${QT_IM_MODULES:-wayland;fcitx}"

exec "$@"
