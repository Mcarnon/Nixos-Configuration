#!/bin/sh
# clavis-session-env — 在启动 Clavis 之前把 Wayland 会话环境补齐。
#
# 为什么需要：clavis-shell.service 是 systemd --user 服务，它继承的是 user
# manager 的环境。niri 由 ly 拉起后作为 user service 运行，WAYLAND_DISPLAY 只有
# niri 自己知道；niri 的 spawn-sh-at-startup 会把它 import 进 user manager，但那要等
# niri 的启动脚本跑到那一行。服务本身被 niri.service 拉起来时可能还拿不到
# socket —— 这正是以前"切到 Quickshell 桌面壳直接黑屏"的根因。
#
# 行为：
#   1. 已有可用的 WAYLAND_DISPLAY 就直接用；
#   2. 否则在 XDG_RUNTIME_DIR 里等 socket 出现（最多 ~20s，优先 wayland-1/2，
#      最后才试 wayland-0 —— 那是常见的 X11/其它会话占用的名字）；
#   3. 顺手 `systemctl --user import-environment`，让 fcitx5 / 截图 / 剪贴板
#      之类的其他 user 服务也拿到同一个 socket；
#   4. exec 真正的命令（通常是 `key shell --foreground --no-duplicate`）。
#
# 用法: clavis-session-env <command> [args...]

set -eu

if [ "$#" -lt 1 ]; then
    echo "usage: clavis-session-env <command> [args...]" >&2
    exit 2
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$runtime_dir"

usable_socket() {
    [ -n "${1:-}" ] && [ -S "$runtime_dir/$1" ]
}

if ! usable_socket "${WAYLAND_DISPLAY:-}"; then
    found=""
    # 20s × 0.5s：niri 通常在 1~2s 内建好 socket，20s 只是保险上限。
    i=0
    while [ "$i" -lt 40 ]; do
        for candidate in wayland-1 wayland-2 wayland-3 wayland-4 wayland-0; do
            if usable_socket "$candidate"; then
                found="$candidate"
                break
            fi
        done
        if [ -n "$found" ]; then
            break
        fi
        i=$((i + 1))
        sleep 0.5
    done
    if [ -z "$found" ]; then
        echo "clavis-session-env: no wayland socket under $runtime_dir" >&2
        exit 3
    fi
    WAYLAND_DISPLAY="$found"
    export WAYLAND_DISPLAY
    # 尽力而为：让别的 user 服务也能看到（失败无所谓，不能因此退出）。
    systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR >/dev/null 2>&1 || true
fi

# Qt/桌面约定：Clavis（Quickshell/Qt6）与 niri 环境块保持一致。
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QS_ICON_THEME="${QS_ICON_THEME:-Adwaita}"
export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
export QT_IM_MODULES="${QT_IM_MODULES:-wayland;fcitx}"

# XDG_DATA_DIRS —— 图标主题的唯一入口。
# Clavis 的一大半图标不是自带的 SVG，而是走系统图标主题解析的：
#   Services/ApplicationService.qml  Quickshell.iconPath(<desktop 文件的 Icon=>, ...)
#   Modules/Dock/DockItem.qml        同上（dock 条目）
#   Components/FileThemeIcon.qml     Quickshell.hasThemeIcon(...)
# NixOS 上 adwaita-icon-theme / papirus-icon-theme 只存在于系统 profile 的
# /run/current-system/sw/share/icons，而 Qt 找不到 XDG_DATA_DIRS 时只回退到
# /usr/local/share:/usr/share（这两个目录在本机不存在）—— 结果是整个图标
# 主题"不存在"，启动器/dock/spotlight 的图标全部空白，而且**没有任何报错**。
#
# 注意：niri 的 `environment {}` 块和 home.sessionVariables 都管不到 systemd
# --user 服务（前者只影响 niri 拉起的子进程，后者要等 environment.d 导入），
# 所以这一段必须在这里自己补。两个根目录分别对应新旧两种系统 profile 布局，
# 只前置存在的，并且保留会话原有的值。
for dir in /run/current-system/sw/share /nix/var/nix/profiles/default/share; do
    if [ -d "$dir" ]; then
        XDG_DATA_DIRS="$dir${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
    fi
done
export XDG_DATA_DIRS
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

exec "$@"
